{
  "default-configuration": "Release",
  "configurations": [
    "Debug",
    "Release",
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
    ],
  },
  "files": [
    { "kind": "folder", "path": "screenshot-app", "target-membership": [ "screenshot-app" ] },
    { "kind": "folder", "path": "GlanceTests", "target-membership": [ "GlanceTests" ] },
    {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/screenshot-app.app", "id": "000000000000000000000120", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/GlanceTests.xctest", "id": "000000000000000000000220", "type": "wrapper.cfbundle", "index": false },
      ],
    },
  ],
  "targets": [
    {
